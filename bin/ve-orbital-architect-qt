#!/bin/sh
# ve-orbital-architect-qt -- launch the Qt satellite selection dashboard.
# Works from the source tree (PYTHONPATH points at the repo root) and from an
# installed layout (VE_PY_ROOT is set by the packaging or install script).

set -eu

if [ -n "${VE_PY_ROOT:-}" ] && [ -d "${VE_PY_ROOT}" ]; then
    export PYTHONPATH="${VE_PY_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
else
    # Resolve the repo root from this script's location.
    _self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    _repo="$(cd "$(dirname "$_self")/.." && pwd)"
    export PYTHONPATH="${_repo}${PYTHONPATH:+:${PYTHONPATH}}"
fi

PY="${VE_PYTHON:-python3}"
exec "$PY" -m python_tracker.qt_dashboards.orbital_architect_qt "$@"
